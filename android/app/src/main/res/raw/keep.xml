<?xml version="1.0" encoding="utf-8"?>
<!-- Resources looked up by name at runtime (notification icons, widget drawables),
     which resource shrinking would otherwise strip from release builds. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_tooran,@drawable/widget_*,@mipmap/ic_launcher,@raw/*" />
